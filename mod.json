{
  "geode": "5.6.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "kr1t.startpos-best-runs",
  "name": "StartPos Best Runs",
  "version": "v1.0.0",
  "developer": "kr1t",
  "description": "Shows your best runs from start positions",
  "dependencies": {
    "geode.node-ids": ">=v1.23.3"
  },
  "resources": {
    "files": ["resources/sound.wav"]
  },
  "tags": ["enhancement", "interface", "utility"],
  "settings": {
    "min-progress": {
      "type": "int",
      "name": "Min run length",
      "min": 1,
      "max": 99,
      "default": 1,
      "control": {
        "arrows": true,
        "arrow-step": 1,
        "slider": true,
        "slider-step": 1,
        "input": true
      }
    },
    "label-template": {
      "type": "string",
      "name": "Display format",
      "default": "{start}%-{end}%",
      "filter": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ{}"
    },
    "animation-duration": {
      "type": "float",
      "name": "Animation duration in seconds",
      "min": 0,
      "max": 5,
      "default": 0.6,
      "control": {
        "arrows": true,
        "arrow-step": 1,
        "slider": true,
        "slider-step": 0.1,
        "input": true
      }
    },
    "sound": {
      "type": "file",
      "name": "New best sound",
      "default": {
        "win": "{mod_resources_dir}/sound.wav",
        "mac": "{mod_resources_dir}/sound.wav",
        "android": "{mod_resources_dir}/sound.wav"
      },
      "control": {
        "dialog": "open",
        "filters": [
          {
            "files": ["*.wav"],
            "description": "Audio"
          }
        ]
      }
    }
  }
}
