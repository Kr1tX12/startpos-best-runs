{
  "geode": "5.6.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "kr1t.startpos-best-runs",
  "name": "StartPos Best Runs",
  "version": "v1.0.0",
  "developer": "kr1t",
  "description": "Shows your best runs from start positions",
  "dependencies": {
    "geode.node-ids": ">=v1.23.3"
  },
  "resources": {
    "files": ["resources/example.png"]
  },
  "links": {
    "source": "https://github.com/Kr1tX12/startpos-best-runs"
  },
  "tags": ["enhancement", "interface", "utility"],
  "settings": {
    "min-progress": {
      "type": "int",
      "name": "Min run length",
      "min": 1,
      "max": 99,
      "default": 1,
      "control": {
        "arrows": true,
        "arrow-step": 1,
        "slider": true,
        "slider-step": 1,
        "input": true
      }
    },
    "display-format": {
      "type": "string",
      "name": "Display format",
      "default": "{start}%-{end}%",
      "filter": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ{}"
    },
    "popup-duration": {
      "type": "float",
      "name": "\"NEW BEST\" popup duration (seconds)",
      "min": 0,
      "max": 5,
      "default": 0.6,
      "control": {
        "arrows": true,
        "arrow-step": 1,
        "slider": true,
        "slider-step": 0.1,
        "input": true
      }
    },
    "enable-in-practice": {
      "type": "bool",
      "name": "Enable in practice mode",
      "default": false
    }
  }
}
